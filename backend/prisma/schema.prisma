// Fiadito — créditos pequeños de tiendas de barrio (montos de hasta S/ 250, solo soles).
// Dos tipos de usuario: ADMIN_SISTEMA y ADMIN_NEGOCIO. Los clientes no acceden al sistema.
// Solo tasas efectivas; no existe TCEA (únicamente la TEA, en compra.tea).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Rol {
  ADMIN_SISTEMA
  ADMIN_NEGOCIO
}

enum EstadoUsuario {
  ACTIVO
  INACTIVO
}

enum EstadoTienda {
  ACTIVA
  INACTIVA
}

enum UnidadMedida {
  UND
  KG
  LT
  PAQ
  SERVICIO
}

enum Periodo {
  DIARIA
  QUINCENAL
  MENSUAL
  BIMESTRAL
  TRIMESTRAL
  CUATRIMESTRAL
  SEMESTRAL
  ANUAL
}

enum EstadoActivo {
  ACTIVO
  INACTIVO
}

enum EstadoCompra {
  VIGENTE
  CANCELADA
}

enum EstadoCuota {
  PENDIENTE
  PAGADA
}

enum EstadoCuentaEstado {
  PENDIENTE
  PAGADO
}

enum TipoItem {
  CUOTA
  MORA
}

enum MedioPago {
  EFECTIVO
  YAPE
  PLIN
  TRANSFERENCIA
}

model Tienda {
  id              BigInt       @id @default(autoincrement())
  ruc             String       @unique @db.Char(11)
  razonSocial     String       @map("razon_social") @db.VarChar(150)
  nombreComercial String       @map("nombre_comercial") @db.VarChar(100)
  giroNegocio     String       @map("giro_negocio") @db.VarChar(60)
  direccion       String       @db.VarChar(200)
  // Baja lógica: conserva historial y bloquea compras nuevas.
  estado          EstadoTienda @default(ACTIVA)

  usuarios  Usuario[]
  productos Producto[]
  clientes  Cliente[]
  compras   Compra[]

  @@map("tienda")
}

model Usuario {
  id           BigInt        @id @default(autoincrement())
  // null para ADMIN_SISTEMA
  tiendaId     BigInt?       @map("tienda_id")
  username     String        @unique @db.VarChar(40)
  passwordHash String        @map("password_hash") @db.VarChar(60)
  nombre       String        @db.VarChar(150)
  rol          Rol
  estado       EstadoUsuario @default(ACTIVO)
  creadoEn     DateTime      @default(now()) @map("creado_en")

  tienda    Tienda?    @relation(fields: [tiendaId], references: [id])
  bitacoras Bitacora[]
  sesiones  Sesion[]

  @@index([tiendaId])
  @@map("usuario")
}

/// Sesión de login: token opaco aleatorio (se guarda solo su SHA-256).
model Sesion {
  id        BigInt   @id @default(autoincrement())
  usuarioId BigInt   @map("usuario_id")
  tokenHash String   @unique @map("token_hash") @db.Char(64)
  creadoEn  DateTime @default(now()) @map("creado_en")
  expiraEn  DateTime @map("expira_en")

  usuario Usuario @relation(fields: [usuarioId], references: [id])

  @@index([usuarioId])
  @@index([expiraEn])
  @@map("sesion")
}

model Bitacora {
  id          BigInt   @id @default(autoincrement())
  usuarioId   BigInt?  @map("usuario_id") // null si falla un login de usuario inexistente
  fechaHora   DateTime @default(now()) @map("fecha_hora")
  accion      String   @db.VarChar(40)
  entidad     String   @db.VarChar(40)
  entidadId   BigInt?  @map("entidad_id")
  detalleJson Json?    @map("detalle_json")
  ip          String?  @db.VarChar(45)

  usuario Usuario? @relation(fields: [usuarioId], references: [id])

  @@index([usuarioId])
  @@index([entidad, entidadId])
  @@index([fechaHora])
  @@map("bitacora")
}

model Parametro {
  id           BigInt    @id @default(autoincrement())
  clave        String    @db.VarChar(40)
  valor        String    @db.VarChar(255)
  vigenteDesde DateTime  @map("vigente_desde") @db.Date
  vigenteHasta DateTime? @map("vigente_hasta") @db.Date

  @@unique([clave, vigenteDesde])
  @@map("parametro")
}

model Producto {
  id                BigInt       @id @default(autoincrement())
  tiendaId          BigInt       @map("tienda_id")
  codigo            String       @db.VarChar(20)
  descripcion       String       @db.VarChar(120)
  marca             String?      @db.VarChar(60)
  proveedor         String?      @db.VarChar(100)
  unidadMedida      UnidadMedida @map("unidad_medida")
  // Ruta subida (/uploads/...) o URL externa.
  imagenUrl         String?      @map("imagen_url") @db.VarChar(255)
  precioContado     Decimal      @map("precio_contado") @db.Decimal(12, 2)
  // Solo referencial: no entra en los cálculos.
  precioCredito     Decimal?     @map("precio_credito") @db.Decimal(12, 2)
  permiteCredito    Boolean      @default(true) @map("permite_credito")
  maxCuotasProducto Int          @default(6) @map("max_cuotas_producto") @db.TinyInt
  estado            EstadoActivo @default(ACTIVO)

  tienda   Tienda          @relation(fields: [tiendaId], references: [id])
  detalles DetalleCompra[]

  @@unique([tiendaId, codigo])
  @@map("producto")
}

model Cliente {
  id               BigInt       @id @default(autoincrement())
  tiendaId         BigInt       @map("tienda_id")
  dni              String       @db.Char(8)
  nombres          String       @db.VarChar(80)
  apellidos        String       @db.VarChar(80)
  direccion        String?      @db.VarChar(150)
  telefono         String?      @db.VarChar(15)
  // Tasas efectivas pactadas.
  tasaInteres      Decimal      @map("tasa_interes") @db.Decimal(12, 7)
  periodoTasa      Periodo      @map("periodo_tasa")
  tasaMora         Decimal      @map("tasa_mora") @db.Decimal(12, 7)
  periodoTasaMora  Periodo      @map("periodo_tasa_mora")
  limiteCredito    Decimal      @map("limite_credito") @db.Decimal(12, 2)
  maxCuotas        Int          @map("max_cuotas") @db.TinyInt
  diaCorte         Int          @map("dia_corte") @db.TinyInt
  horaCorte        DateTime     @map("hora_corte") @db.Time(0)
  diaPago          Int          @map("dia_pago") @db.TinyInt
  // Ley 29733
  aceptaPrivacidad Boolean      @default(false) @map("acepta_privacidad")
  estado           EstadoActivo @default(ACTIVO)

  tienda        Tienda         @relation(fields: [tiendaId], references: [id])
  compras       Compra[]
  estadosCuenta EstadoCuenta[]

  @@unique([tiendaId, dni])
  @@map("cliente")
}

model Compra {
  id                BigInt       @id @default(autoincrement())
  tiendaId          BigInt       @map("tienda_id")
  clienteId         BigInt       @map("cliente_id")
  fechaHora         DateTime     @map("fecha_hora")
  capitalInicial    Decimal      @map("capital_inicial") @db.Decimal(12, 2)
  nCuotas           Int          @map("n_cuotas") @db.TinyInt
  fechaCorteCiclo   DateTime     @map("fecha_corte_ciclo")
  fechaFinGracia    DateTime     @map("fecha_fin_gracia") @db.Date
  diasGracia        Int          @map("dias_gracia")
  tasaGracia        Decimal      @map("tasa_gracia") @db.Decimal(18, 12)
  interesGracia     Decimal      @map("interes_gracia") @db.Decimal(12, 2)
  capitalFinanciado Decimal      @map("capital_financiado") @db.Decimal(12, 2)
  tem               Decimal      @db.Decimal(18, 12)
  cuotaRegular      Decimal      @map("cuota_regular") @db.Decimal(12, 2)
  tea               Decimal      @db.Decimal(12, 7)
  estado            EstadoCompra @default(VIGENTE)

  tienda   Tienda          @relation(fields: [tiendaId], references: [id])
  cliente  Cliente         @relation(fields: [clienteId], references: [id])
  detalles DetalleCompra[]
  cuotas   Cuota[]

  @@index([clienteId, fechaHora])
  @@index([tiendaId])
  @@map("compra")
}

model DetalleCompra {
  id                     BigInt  @id @default(autoincrement())
  compraId               BigInt  @map("compra_id")
  productoId             BigInt  @map("producto_id")
  cantidad               Decimal @db.Decimal(10, 3)
  precioUnitarioAplicado Decimal @map("precio_unitario_aplicado") @db.Decimal(12, 2)
  subtotal               Decimal @db.Decimal(12, 2)

  compra   Compra   @relation(fields: [compraId], references: [id])
  producto Producto @relation(fields: [productoId], references: [id])

  @@index([compraId])
  @@map("detalle_compra")
}

model Cuota {
  id               BigInt      @id @default(autoincrement())
  compraId         BigInt      @map("compra_id")
  estadoCuentaId   BigInt?     @map("estado_cuenta_id")
  numero           Int         @db.TinyInt
  fechaVencimiento DateTime    @map("fecha_vencimiento") @db.Date
  saldoInicial     Decimal     @map("saldo_inicial") @db.Decimal(12, 2)
  interes          Decimal     @db.Decimal(12, 2)
  amortizacion     Decimal     @db.Decimal(12, 2)
  montoCuota       Decimal     @map("monto_cuota") @db.Decimal(12, 2)
  saldoFinal       Decimal     @map("saldo_final") @db.Decimal(12, 2)
  estado           EstadoCuota @default(PENDIENTE)

  compra       Compra             @relation(fields: [compraId], references: [id])
  estadoCuenta EstadoCuenta?      @relation(fields: [estadoCuentaId], references: [id])
  items        EstadoCuentaItem[]
  pago         Pago?

  @@unique([compraId, numero])
  @@index([estado, fechaVencimiento])
  @@index([estadoCuentaId])
  @@map("cuota")
}

/// Estado de cuenta del cliente en una fecha de corte (documento con las cuotas del ciclo).
model EstadoCuenta {
  id                   BigInt             @id @default(autoincrement())
  clienteId            BigInt             @map("cliente_id")
  fechaCorte           DateTime           @map("fecha_corte") @db.Date
  fechaPago            DateTime           @map("fecha_pago") @db.Date
  totalCapital         Decimal            @map("total_capital") @db.Decimal(12, 2)
  totalInteresesCuotas Decimal            @map("total_intereses_cuotas") @db.Decimal(12, 2)
  total                Decimal            @db.Decimal(12, 2)
  // PAGADO cuando todas sus cuotas están pagadas.
  estado               EstadoCuentaEstado @default(PENDIENTE)

  cliente Cliente            @relation(fields: [clienteId], references: [id])
  cuotas  Cuota[]
  items   EstadoCuentaItem[]

  // Evita generar dos veces el estado del mismo corte.
  @@unique([clienteId, fechaCorte])
  @@map("estado_cuenta")
}

model EstadoCuentaItem {
  id             BigInt   @id @default(autoincrement())
  estadoCuentaId BigInt   @map("estado_cuenta_id")
  cuotaId        BigInt?  @map("cuota_id")
  tipo           TipoItem
  fecha          DateTime @db.Date
  descripcion    String   @db.VarChar(150)
  capital        Decimal  @db.Decimal(12, 2)
  dias           Int?
  tasaPeriodo    Decimal? @map("tasa_periodo") @db.Decimal(18, 12)
  interes        Decimal  @db.Decimal(12, 2)
  subtotal       Decimal  @db.Decimal(12, 2)

  estadoCuenta EstadoCuenta @relation(fields: [estadoCuentaId], references: [id])
  cuota        Cuota?       @relation(fields: [cuotaId], references: [id])

  @@index([estadoCuentaId])
  @@map("estado_cuenta_item")
}

/// Pago de una cuota (completa, una sola vez). Prelación: mora → interés → capital.
model Pago {
  id              BigInt    @id @default(autoincrement())
  // UNIQUE: una cuota solo se paga una vez.
  cuotaId         BigInt    @unique @map("cuota_id")
  fechaPagoReal   DateTime  @map("fecha_pago_real") @db.Date
  diasMora        Int       @map("dias_mora")
  tasaMoraPeriodo Decimal?  @map("tasa_mora_periodo") @db.Decimal(18, 12)
  montoMora       Decimal   @map("monto_mora") @db.Decimal(12, 2)
  montoInteres    Decimal   @map("monto_interes") @db.Decimal(12, 2)
  montoCapital    Decimal   @map("monto_capital") @db.Decimal(12, 2)
  montoTotal      Decimal   @map("monto_total") @db.Decimal(12, 2)
  medioPago       MedioPago @map("medio_pago")

  cuota Cuota @relation(fields: [cuotaId], references: [id])

  @@map("pago")
}
